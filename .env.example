# Copy to .env and adjust. Never commit real keys.

# --- Database (docker compose up -d) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/saas_starter

# --- App ---
APP_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-me

# --- Sign-in: email magic link ---
# Leave EMAIL_SERVER empty in development: the sign-in link is printed to the terminal.
# With `docker compose --profile mail up -d`, use smtp://localhost:1025 and open http://localhost:8025.
EMAIL_SERVER=
EMAIL_FROM="SaaS Starter <no-reply@example.com>"

# --- Sign-in: GitHub OAuth (optional; button appears when both are set) ---
# Callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# --- Stripe, TEST MODE only (optional; billing buttons appear when set) ---
# Dashboard > Developers > API keys (test mode). The webhook secret comes from
# `stripe listen --forward-to localhost:3000/api/stripe/webhook`.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_PRO=price_replace_me
